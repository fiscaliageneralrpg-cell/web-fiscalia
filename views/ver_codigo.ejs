<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= item.titulo %> - CodeSnap</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/themes/prism-tomorrow.min.css">
    <style>
        body { background: #1d1d1f; color: white; margin: 0; font-family: -apple-system; padding: 40px; display: flex; justify-content: center; }
        .viewer { width: 100%; max-width: 900px; }
        header { margin-bottom: 30px; border-left: 4px solid #007AFF; padding-left: 20px; }
        .code-box { border-radius: 16px; overflow: hidden; background: #000; padding: 10px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
        .btn-action { background: #323235; color: white; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; margin-top: 20px; text-decoration: none; display: inline-block; }
    </style>
</head>
<body>
    <div class="viewer">
        <header>
            <h1 style="margin:0;"><%= item.titulo %></h1>
            <p style="color:#86868b;">Escrito en <%= item.lenguaje %> por <b><%= item.autor %></b></p>
        </header>
        <div class="code-box">
            <pre><code class="language-<%= item.lenguaje %>"><%= item.contenido %></code></pre>
        </div>
        <a href="/publicados" class="btn-action">← Volver al Mural</a>
        <button onclick="window.print()" class="btn-action">Guardar PDF</button>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.24.1/components/prism-lua.min.js"></script>
</body>
</html>