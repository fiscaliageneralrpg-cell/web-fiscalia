<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mural - CodeSnap</title>
    <style>
        body { background: #f5f5f7; margin: 0; font-family: -apple-system; padding: 40px; }
        .container { max-width: 1000px; margin: auto; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }
        .code-card { background: white; padding: 25px; border-radius: 24px; border: 1px solid #e5e5e7; transition: transform 0.2s; }
        .code-card:hover { transform: translateY(-5px); border-color: #007AFF; }
        .tag { background: #f2f2f7; color: #1d1d1f; padding: 4px 12px; border-radius: 10px; font-size: 12px; font-weight: 600; }
        .btn-view { display: block; margin-top: 15px; text-decoration: none; color: #007AFF; font-weight: 600; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Mural Público</h1>
            <a href="/login" style="background:#007AFF; color:white; padding:10px 20px; border-radius:20px; text-decoration:none;">+ Publicar</a>
        </header>
        <div class="grid">
            <% lista.forEach(item => { %>
                <div class="code-card">
                    <span class="tag"><%= item.lenguaje.toUpperCase() %></span>
                    <h3 style="margin: 15px 0 5px 0;"><%= item.titulo %></h3>
                    <p style="color:#86868b; font-size:0.9rem;">Autor: <%= item.autor %></p>
                    <a href="/codigo/<%= item.id %>" class="btn-view">Abrir CodeSnap →</a>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>